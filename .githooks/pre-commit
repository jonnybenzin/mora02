#!/bin/sh
# Two-stage commit gate.
#
#   Stage 1  gitleaks      - the VALUE level: does this change carry a secret?
#   Stage 2  boundary-guard - the ASSIGNMENT level: does this file belong in a
#                             public application repository at all?
#
# They catch different failure classes. A systemd unit naming the NAS carries no
# secret and passes stage 1 cleanly, yet publishes a map of this machine.
#
# ---------------------------------------------------------------- stage 1 ----
# Refuse commits that carry credentials.
#
# Why this exists: in March 2026 a personal password plus the matching e-mail
# address reached this repository inside a login payload and stayed public for
# five months. A security sweep in May touched the very same file and missed it,
# because the value did not *look* like a secret - a short, pronounceable word
# in a JSON literal rather than a random-looking string. gitleaks matches on
# context (password=, token-auth payloads, connection URIs), not on shape.
#
# Scope: staged changes only, so it stays fast. History is not rescanned - the
# old values are rotated and therefore worthless.
#
# Bypass, only when you are certain it is a false positive:
#   git commit --no-verify

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed - install it with 'sudo apt install gitleaks'." >&2
    echo "            Commit refused rather than silently unchecked." >&2
    exit 1
fi

# --redact keeps any finding out of the terminal and out of session logs.
if ! gitleaks protect --staged --redact --verbose; then
    echo "" >&2
    echo "pre-commit: a credential was found in the staged changes - commit refused." >&2
    echo "            Move the value into docker/.env (or another file outside git)" >&2
    echo "            and reference it from the code instead." >&2
    exit 1
fi

# ---------------------------------------------------------------- stage 2 ----
# Refuse commits that add host infrastructure to this public repository.
# Runs only after stage 1 passes, so a file is never judged on assignment while
# it still carries a secret. See .githooks/boundary-guard and .boundaryignore.

HOOK_DIR=$(dirname "$0")
if [ -x "$HOOK_DIR/boundary-guard" ]; then
    "$HOOK_DIR/boundary-guard" || exit 1
else
    echo "pre-commit: boundary-guard missing or not executable - commit refused" >&2
    echo "            rather than silently unchecked. Expected: $HOOK_DIR/boundary-guard" >&2
    exit 1
fi
