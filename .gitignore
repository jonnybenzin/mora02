*.blend
*.blend1

# Archives / Exports
*.zip
*.tar.gz
*.xml

# SQLite Datenbanken
*.sqlite

# Pipeline run logs (JSONL, one file per run — runtime data, not source)
pipelines/logs/
# Pipeline run bucket (per-run step outputs for non-linear fan-in — runtime data)
pipelines/bucket/

# Screendesign (Playwright-Screenshots & Design-Input)
apps/pilot/ui/screendesign/

# Personal / not for public repo (decided 2026-05-14)
CLAUDE.md
apps/matrix-tool/
apps/chatterbox-api/
x_briefing/
llm-switch/

# --- Repository boundary: what belongs to a different lifecycle ---
# Host infrastructure, not the mora02 application. The backup system really
# lives in /root/backup-fullsystem.sh, a systemd timer and the Borg repo on the
# NAS; only three convenience wrappers ever sat here. Headed for its own
# private repo together with those parts.
scripts/backup/

# Separate product with its own release cycle, destined for private GitLab.
# Must never land in this public repository.
apps/matrix-tool-v2/

# Plans, notes, roadmap. Own audience (one person), own rhythm, own repository
# -- test 3 of the boundary question in CLAUDE.md. This is a private git repo
# of its own living inside the working directory, so the notes sit next to the
# work they describe while belonging to a different history. Do not un-ignore:
# a plan that lands in the public repo is a plan published by accident.
notizen/

# Tool-calling bench output: measurements of this machine at this moment.
# The runner is public, its results are not (MORA02_BENCH_OUT overrides).
bench-results/
docker/searxng/settings.yml.bak-*
