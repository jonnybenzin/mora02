# =============================================================
# Mora02 - central configuration (template)
# =============================================================
# Fresh install:
#   1. cp .env.example .env
#   2. fill in every value below
#   3. docker compose --profile <llm-profile> up -d
# Every variable listed here is referenced as ${NAME} in
# docker-compose.yml. If a name is not in this file, the stack
# does not read it - keep the real .env in sync with this list.
# =============================================================

# --- Baserow (database / CMS) ---
POSTGRES_BASEROW_PASSWORD=
BASEROW_TOKEN=

# --- Penpot (design tool) + its Postgres and Redis ---
POSTGRES_TOOLS_PASSWORD=
PENPOT_DATABASE_PASSWORD=
PENPOT_SECRET_KEY=
REDIS_PASSWORD=

# --- SearXNG (metasearch) ---
SEARXNG_SECRET_KEY=

# --- Cloud APIs (only used when actively selected) ---
CLAUDE_API_KEY=
GOOGLE_API_KEY=
FAL_KEY=

# --- Stock photo APIs (script-runner) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Publishing: LinkedIn (token expires after ~60 days) ---
MORA02_LINKEDIN_TOKEN=
MORA02_LINKEDIN_AUTHOR=

# --- Notifications ---
# Signal target for gate approvals and media previews (phone number)
MORA02_SIGNAL_TARGET=
# Where a failed pipeline run reports to (channel name, empty = off)
MORA02_RUN_FAILURE_NOTIFY=
# E-mail channel (optional; leave empty to disable)
#MORA02_EMAIL_TARGET=
#MORA02_SMTP_HOST=
#MORA02_SMTP_PORT=
#MORA02_SMTP_USER=
#MORA02_SMTP_PASSWORD=
#MORA02_SMTP_FROM=
#MORA02_SMTP_SECURITY=

# --- OpenClaw gateway (local agent runtime) ---
MORA02_OPENCLAW_TOKEN=
