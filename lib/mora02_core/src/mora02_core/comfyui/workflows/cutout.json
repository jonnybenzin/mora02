{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input_image.png"
    },
    "_meta": {
      "title": "Source image"
    }
  },
  "4": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "3",
        1
      ]
    },
    "_meta": {
      "title": "Subject -> keep (JoinImageWithAlpha inverts)"
    }
  },
  "5": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "alpha": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Original colour + matte = straight alpha"
    }
  },
  "6": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "cutout",
      "images": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Save RGBA"
    }
  },
  "2": {
    "class_type": "RemBGSession+",
    "inputs": {
      "model": "isnet-general-use: general purpose",
      "providers": "CUDA"
    },
    "_meta": {
      "title": "Matting model (rembg)"
    }
  },
  "3": {
    "class_type": "ImageRemoveBackground+",
    "inputs": {
      "rembg_session": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Matte"
    }
  }
}
