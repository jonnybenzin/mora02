{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input_image.png"
    },
    "_meta": {
      "title": "Source image"
    }
  },
  "2": {
    "class_type": "Efficient Loader",
    "inputs": {
      "ckpt_name": "sd_v1-5.safetensors",
      "vae_name": "Baked VAE",
      "clip_skip": -2,
      "lora_name": "None",
      "lora_model_strength": 1,
      "lora_clip_strength": 1,
      "positive": "detailed face, sharp eyes, natural skin texture, high quality",
      "negative": "blurry, deformed, bad anatomy, poorly drawn face, extra eyes, disfigured, low quality",
      "token_normalization": "none",
      "weight_interpretation": "A1111",
      "empty_latent_width": 512,
      "empty_latent_height": 512,
      "batch_size": 1
    },
    "_meta": {
      "title": "Refiner model (SD1.5)"
    }
  },
  "3": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "bbox/face_yolov8m.pt"
    },
    "_meta": {
      "title": "Face detector"
    }
  },
  "4": {
    "class_type": "FaceDetailer",
    "inputs": {
      "guide_size": 768,
      "guide_size_for": true,
      "max_size": 1152,
      "seed": 3,
      "steps": 30,
      "cfg": 7,
      "sampler_name": "euler_ancestral",
      "scheduler": "karras",
      "denoise": 0.4,
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 3,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": 10,
      "wildcard": "",
      "cycle": 1,
      "inpaint_model": false,
      "noise_mask_feather": 0,
      "tiled_encode": true,
      "tiled_decode": false,
      "image": [
        "1",
        0
      ],
      "model": [
        "2",
        0
      ],
      "clip": [
        "2",
        5
      ],
      "vae": [
        "2",
        4
      ],
      "positive": [
        "2",
        1
      ],
      "negative": [
        "2",
        2
      ],
      "bbox_detector": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Refine each face"
    }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "facefix",
      "images": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Save"
    }
  }
}
